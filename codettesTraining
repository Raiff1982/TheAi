Safe Timeout Wrapper (Linux only – works in Kaggle)\n# ==========================================================\n\nclass TimeoutError(Exception):\n    pass\n\n\n@contextmanager\ndef timeout(seconds: int):\n    def _handle_timeout(signum, frame):\n        raise TimeoutError(\"Execution timed out\")\n\n    signal.signal(signal.SIGALRM, _handle_timeout)\n    signal.alarm(seconds)\n\n    try:\n        yield\n    finally:\n        signal.alarm(0)\n\n\n# ==========================================================\n# 2️⃣  Model Loader (NO AUTO-LOAD ON IMPORT)\n# ==========================================================\n\ndef load_llama_model(\n    repo_id: str,\n    filename: str,\n    n_ctx: int = 4096,\n    n_gpu_layers: int = -1,\n    tensor_split: Optional[List[float]] = None,\n    main_gpu: int = 0,\n    n_batch: int = 1024,\n    verbose: bool = True,\n):\n    \"\"\"\n    Explicit model bootstrap.\n    Loads GGUF model and distributes across GPUs if configured.\n    \"\"\"\n\n    print(f\"Downloading model: {repo_id}/{filename}\")\n    model_path = hf_hub_download(repo_id=repo_id, filename=filename)\n\n    print(\"Initializing llama.cpp runtime...\")\n\n    llm = Llama(\n        model_path=model_path,\n        n_ctx=n_ctx,\n        n_gpu_layers=n_gpu_layers,\n        tensor_split=tensor_split,\n        main_gpu=main_gpu,\n        n_batch=n_batch,\n        verbose=verbose,\n    )\n\n    print(\"Model loaded successfully.\")\n    return llm\n\n\n# ==========================================================\n# 3️⃣  Python Execution Tool (Isolated & Recoverable)\n# ==========================================================\n\nclass PythonTool:\n    \"\"\"\n    Executes Python safely in subprocess isolation.\n    \"\"\"\n\n    def __init__(self, timeout_seconds: int = 10):\n        self.timeout_seconds = timeout_seconds\n\n    def execute(self, code: str) -> dict:\n        try:\n            with timeout(self.timeout_seconds):\n                result = subprocess.run(\n                    [\"python3\", \"-c\", code],\n                    capture_output=True,\n                    text=True,\n                )\n\n            return {\n                \"success\": result.returncode == 0,\n                \"stdout\": result.stdout.strip(),\n                \"stderr\": result.stderr.strip(),\n                \"returncode\": result.returncode,\n            }\n\n        except TimeoutError:\n            return {\n                \"success\": False,\n                \"error\": \"Execution timed out\",\n            }\n\n        except Exception as e:\n            return {\n                \"success\": False,\n                \"error\": str(e),\n            }\n\n\n# ==========================================================\n# 4️⃣  Kaggle Dual-T4 Configuration\n# ==========================================================\n\ndef kaggle_dual_t4_config():\n    \"\"\"\n    Prebuilt config for Kaggle Tesla T4 x2\n    \"\"\"\n\n    return {\n        \"repo_id\": \"unsloth/gpt-oss-20b-GGUF\",\n        \"filename\": \"gpt-oss-20b-Q4_K_M.gguf\",  # NOT F16\n        \"n_ctx\": 4096,\n        \"n_gpu_layers\": -1,\n        \"tensor_split\": [0.5, 0.5],  # Use both T4 GPUs\n        \"main_gpu\": 0,\n        \"n_batch\": 1024,\n        \"verbose\": True, \n    }\n\n\n# ==========================================================\n# 5️⃣  Example Bootstrap (ONLY RUN WHEN CALLED)\n# ==========================================================\n\ndef bootstrap_llm():\n    config = kaggle_dual_t4_config()\n    return load_llama_model(**config)\n\n\n# ==========================================================\n# 6️⃣  Example Usage\n# ==========================================================\n\nif __name__ == \"__main__\":\n\n    print(\"Bootstrapping Codette Runtime...\")\n\n    llm = bootstrap_llm()\n\n    prompt = \"Explain quantum tunneling in simple terms.\"\n\n    output = llm(\n        prompt,\n        max_tokens=200,\n        temperature=0.7,\n    )\n\n    print(\"\\n--- MODEL OUTPUT ---\\n\")\n    print(output[\"choices\"][0][\"text\"])\n\n    # Example tool usage\n    python_tool = PythonTool(timeout_seconds=5)\n\n    tool_result = python_tool.execute(\"print(2 + 2)\")\n\n    print(\"\\n--- PYTHON TOOL RESULT ---\\n\")\n    print(tool_result)","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}