if not dataset_path.exists():\n    raise RuntimeError(f\"Dataset not found: {TRAIN_FILE}\")\n\nprint(\"\\nLoading dataset\\n\")\n\ndataset = load_dataset(\n    \"json\",\n    data_files = str(dataset_path),\n    split = \"train\"\n)\n\nprint(\"Samples:\", len(dataset))\n\n\n# -----------------------------------------------------\n# FORMAT DATASET\n# -----------------------------------------------------\n\ndef format_example(example):\n\n    instruction = example.get(\"instruction\")\n    output = example.get(\"output\")\n\n    if instruction is None or output is None:\n        return {\"text\": \"\"}\n\n    messages = [\n        {\"role\": \"user\", \"content\": str(instruction)},\n        {\"role\": \"assistant\", \"content\": str(output)}\n    ]\n\n    text = tokenizer.apply_chat_template(\n        messages,\n        tokenize = False,\n        add_generation_prompt = False\n    )\n\n    return {\"text\": text}\n\n\ndataset = dataset.map(format_example)\n\ndataset = dataset.filter(lambda x: len(x[\"text\"]) > 0)\n\n\n# -----------------------------------------------------\n# TOKENIZE\n# -----------------------------------------------------\n\ndef tokenize(example):\n\n    return tokenizer(\n        example[\"text\"],\n        truncation = True,\n        padding = \"max_length\",\n        max_length = MAX_SEQ_LENGTH\n    )\n\n\ndataset = dataset.map(tokenize, batched=True)\n\ndataset.set_format(\n    type=\"torch\",\n    columns=[\"input_ids\", \"attention_mask\"]\n)\n\n\n# -----------------------------------------------------\n# COLLATOR\n# -----------------------------------------------------\n\ndata_collator = DataCollatorForLanguageModeling(\n    tokenizer = tokenizer,\n    mlm = False\n)\n\n\n# -----------------------------------------------------\n# TRAINING SETTINGS\n# -----------------------------------------------------\n\ntraining_args = TrainingArguments(\n\n    output_dir = OUTPUT_DIR,\n\n    per_device_train_batch_size = BATCH,\n    gradient_accumulation_steps = GRAD_ACCUM,\n\n    num_train_epochs = EPOCHS,\n\n    learning_rate = LEARNING_RATE,\n\n    warmup_steps = 10,\n\n    logging_steps = 10,\n\n    optim = \"adamw_8bit\",\n\n    lr_scheduler_type = \"cosine\",\n\n    fp16 = True,\n\n    save_strategy = \"epoch\",\n    save_total_limit = 2,\n\n    report_to = \"none\",\n\n    dataloader_num_workers = 2,\n\n    gradient_checkpointing = True,\n\n    seed = 42\n)\n\n\n# -----------------------------------------------------\n# TRAINER\n# -----------------------------------------------------\n\ntrainer = Trainer(\n    model = model,\n    train_dataset = dataset,\n    args = training_args,\n    data_collator = data_collator\n)\n\nFastLanguageModel.for_training(model)\n\n\n# -----------------------------------------------------\n# TRAIN\n# -----------------------------------------------------\n\nprint(\"\\n=== TRAINING START ===\\n\")\n\nstats = trainer.train()\n\nprint(\"\\nTraining complete\")\n\nprint(\"Steps:\", stats.global_step)\nprint(\"Loss:\", stats.training_loss)\n\n\n# -----------------------------------------------------\n# SAVE LORA\n# -----------------------------------------------------\n\nprint(\"\\nSaving LoRA adapters\\n\")\n\nlora_dir = OUTPUT_DIR + \"/lora\"\n\nmodel.save_pretrained(lora_dir)\ntokenizer.save_pretrained(lora_dir)\n\nprint(\"Saved to:\", lora_dir)\n\n\n# -----------------------------------------------------\n# GGUF EXPORT\n# -----------------------------------------------------\n\nprint(\"\\nAttempting GGUF export\\n\")\n\ntry:\n\n    gguf_dir = OUTPUT_DIR + \"/gguf\"\n\n    model.save_pretrained_gguf(\n        gguf_dir,\n        tokenizer,\n        quantization_method = \"q4_k_m\"\n    )\n\n    print(\"GGUF export successful\")\n\nexcept Exception as e:\n\n    print(\"GGUF export skipped:\", e)\n\n\nprint(\"\\nPipeline complete\\n\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-12T16:55:58.393419Z","iopub.execute_input":"2026-03-12T16:55:58.393730Z"}},"outp